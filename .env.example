# --- Shopify (server-only; never prefix with NEXT_PUBLIC_) ---
# Domain example: your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=
# Public Storefront API access token (Headless channel / custom app). NOT an Admin API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Signing secret for /api/webhooks/shopify (Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Optional: restrict affiliate links to these domains (comma-separated, subdomains allowed).
# Example: amazon.com,amzn.to,a.co,walmart.com
AFFILIATE_ALLOWED_HOSTS=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: hero image URL or /public path
NEXT_PUBLIC_HERO_IMAGE=

# --- Social links ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DISCORD_URL=

# --- "Partner with me" form delivery (set one) ---
PARTNER_WEBHOOK_URL=
PARTNER_FORM_ENDPOINT=
